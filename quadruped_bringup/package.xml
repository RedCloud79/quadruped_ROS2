<?xml version="1.0"?>
<package format="3">
  <name>quadruped_bringup</name>
  <version>0.0.1</version>
  <description>
    Bringup package for my robot integrating Nav2, Fast-LIO, and Autoware localization.
  </description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>tier4_localization_launch</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <!-- Optional: if you use RViz or other tools -->
  <exec_depend>rviz2</exec_depend>

  <!-- Export build type -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>